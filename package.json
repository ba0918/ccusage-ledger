{
  "name": "ccusage-ledger",
  "version": "0.1.2",
  "description": "Agent CLI usage dashboard: visualize cost, tokens, and cache hit rates from ccusage data",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/ba0918/ccusage-ledger.git" },
  "homepage": "https://github.com/ba0918/ccusage-ledger#readme",
  "bugs": { "url": "https://github.com/ba0918/ccusage-ledger/issues" },
  "packageManager": "bun@1.3.14",
  "keywords": ["ccusage", "claude-code", "codex", "opencode", "dashboard", "usage"],
  "bin": {
    "ccusage-ledger": "dist/ccusage-ledger.js"
  },
  "files": [
    "bun.lock",
    "index.html",
    "dist/bundle.js",
    "dist/ccusage-ledger.js",
    "public/app.css",
    "public/vendor/chart.umd.min.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run build && bun run src/server.ts",
    "build": "bun build src/client/main.ts --outfile dist/bundle.js && bun build src/cli.ts --target=node --outfile dist/ccusage-ledger.js",
    "export": "bun run build && bun run src/export.ts",
    "prepare": "bun run build",
    "prepublishOnly": "bun test && bunx tsc --noEmit && bun run lint && bun run build",
    "test": "bun test",
    "lint": "bunx biome lint src/",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.1.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "ccusage": "20.0.19",
    "hono": "4.13.0"
  }
}
