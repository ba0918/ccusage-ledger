{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!!**/dist"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				// noUncheckedIndexedAccess で配列アクセスが unknown になるため、このコードベースは
				// 型ガード後に ! で縮小する慣用を使う（noNonNullAssertion は lint ノイズになる）
				"noNonNullAssertion": "off",
				// 一行 if/for の波括弧省略は可読性と差分のノイズを生むため強制する
				"useBlockStatements": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
